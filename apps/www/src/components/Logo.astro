---
type Props = {
  href?: string;
};

const { href = "/" } = Astro.props as Props;
---

<a class="brand-lockup" href={href} aria-label="AutoSEO.run home">
  <img
    class="brand-lockup__mark"
    src="/brand/autoseo-mark.svg"
    width="32"
    height="32"
    alt=""
    aria-hidden="true"
  />
  <span class="brand-lockup__word">autoseo<span class="brand-lockup__tld">.run</span></span>
</a>
