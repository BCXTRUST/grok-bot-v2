<form id="login" method="post" action="{{loginAction}}" class="{{formClass}}">
<h1>Login</h1>
{{{error}}}
<label for="{{userId}}">Username</label>
<input id="{{userId}}" name="{{userName}}" autocomplete="username" />
<label for="{{passwordId}}">Password</label>
<input id="{{passwordId}}" name="{{passwordName}}" type="password" autocomplete="current-password" />
<button type="submit" name="submit" id="submit" value="1">Login</button>
</form>
