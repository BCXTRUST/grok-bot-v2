<form action="./ucp.php?mode=login" method="post" id="login">
<div class="panel"><h2>Login</h2>
{{{error}}}
<dl><dt><label for="username">Username:</label></dt><dd><input type="text" name="username" id="username" class="inputbox autowidth" /></dd></dl>
<dl><dt><label for="password">Password:</label></dt><dd><input type="password" name="password" id="password" class="inputbox autowidth" autocomplete="off" /></dd></dl>
<input type="submit" name="login" value="Login" class="button1" />
</div>
</form>
