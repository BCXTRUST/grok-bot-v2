<!DOCTYPE html>
<html dir="ltr" lang="en-gb">
<head>
<meta charset="utf-8" />
<title>{{title}} - {{boardName}}</title>
<style>
body { font-family: Verdana, Helvetica, Arial, sans-serif; background: #f5f7fa; color: #28313f; margin: 0; }
#wrap { max-width: 960px; margin: 0 auto; padding: 12px 18px; background: #fff; min-height: 100vh; }
.headerbar { background: linear-gradient(#6aceff, #0076b1); color: #fff; padding: 12px 16px; border-radius: 7px; }
.headerbar h1 { margin: 0; font-size: 22px; }
.navbar { background: #cadceb; padding: 6px 12px; border-radius: 7px; margin: 6px 0 12px; font-size: 12px; }
.navbar a { color: #105289; }
.panel, .post { background: #ecf1f3; border-radius: 7px; padding: 10px 14px; margin-bottom: 8px; }
.post.bg2 { background: #e1ebf2; }
.author { font-size: 11px; color: #555; }
.content { font-size: 14px; line-height: 1.5; }
.postlink { color: #368ad2; border-bottom: 1px solid #368ad2; text-decoration: none; }
ul.topiclist { list-style: none; padding: 0; }
li.row { padding: 6px 10px; border-bottom: 1px solid #fff; background: #ecf3f7; }
.error { color: #bc2a4d; font-weight: bold; }
.button1, .button { background: #e9e9e9; border: 1px solid #c7c3bf; padding: 4px 10px; border-radius: 4px; color: #105289; text-decoration: none; }
dl { margin: 6px 0; } dt { font-weight: bold; } input.inputbox, textarea.inputbox { width: 60%; padding: 4px; }
#cookie-consent { position: fixed; bottom: 0; left: 0; right: 0; background: #222; color: #fff; padding: 12px; text-align: center; }
</style>
</head>
<body id="phpbb">
<div id="wrap">
<div class="headerbar"><h1>{{boardName}}</h1><p>Community support board</p></div>
<div class="navbar"><a href="./index.php">Board index</a> &middot; {{{navUser}}}</div>
<div id="page-body">
{{{content}}}
</div>
</div>
{{{cookieBanner}}}
</body>
</html>
